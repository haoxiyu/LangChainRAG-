# ===== 阿里云百炼(DashScope) =====
# 从 https://bailian.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 对话与向量化走 OpenAI 兼容模式
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 重排序只能走原生接口(兼容模式返回 404)
DASHSCOPE_NATIVE_BASE=https://dashscope.aliyuncs.com/api/v1/services

# 实测可用模型(勿照抄官方文档的 text-embedding-v3 / gte-rerank,该账号下不存在)
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3.7-text-rerank
EMBEDDING_DIM=1024

# ===== 数据库 =====
# 留空则自动用 pgembed 启动项目内嵌的 PostgreSQL(免安装免 Docker)
# 也可填外部数据库,例如 postgresql://user:pass@host:5432/ragdb
DATABASE_URL=
DB_NAME=ragdb

# ===== 鉴权 =====
SECRET_KEY=please-generate-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 管理员种子账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ===== 检索调优(可选) =====
# RETRIEVE_TOP_K=20
# RERANK_TOP_K=5
# ENABLE_RERANK=true
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80

# ===== 缓存与限流(可选) =====
# CACHE_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
